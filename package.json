{
  "name": "mollier-hx-card",
  "version": "0.1.0",
  "description": "Home Assistant card: a Mollier h,x (psychrometric) diagram of your room climate, one point per day, with comfort zone, warning bands and outside air.",
  "type": "module",
  "source": "src/mollier-hx-card.js",
  "scripts": {
    "build": "parcel build --no-source-maps --no-cache",
    "watch": "parcel watch",
    "screenshots": "node scripts/screenshots.mjs",
    "social-preview": "node scripts/social-preview.mjs",
    "visual-check": "node scripts/visual-check.mjs",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "check-shared": "node scripts/check-shared.mjs",
    "demo": "node scripts/demo.mjs",
    "e2e": "node scripts/e2e.mjs"
  },
  "targets": {
    "default": {
      "distDir": "dist",
      "publicUrl": "./",
      "includeNodeModules": true
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.15.0",
    "eslint-plugin-lit": "^2.3.1",
    "eslint-plugin-wc": "^3.1.0",
    "globals": "^17.14.0",
    "happy-dom": "^21.0.4",
    "parcel": "^2.16.4",
    "prettier": "^3.10.1",
    "puppeteer-core": "^25.16.0",
    "vitest": "^5.1.2"
  },
  "dependencies": {
    "d3-array": "^3.2.4",
    "d3-axis": "^3.0.0",
    "d3-scale": "^4.0.2",
    "d3-selection": "^3.0.0",
    "d3-shape": "^3.2.0",
    "lit": "^3.3.3"
  }
}
