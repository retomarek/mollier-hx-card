{
  "name": "mollier-hx-card",
  "version": "1.0.0-beta.3",
  "description": "A Home Assistant custom card that renders a Mollier h-x diagram from temperature and humidity sensor data.",
  "type": "module",
  "source": "src/mollier-hx-card.js",
  "scripts": {
    "build": "parcel build --no-source-maps --no-cache",
    "watch": "parcel watch",
    "screenshots": "node scripts/screenshots.mjs",
    "social-preview": "node scripts/social-preview.mjs",
    "visual-check": "node scripts/visual-check.mjs"
  },
  "targets": {
    "default": {
      "distDir": "dist",
      "publicUrl": "./",
      "includeNodeModules": true
    }
  },
  "devDependencies": {
    "parcel": "^2.16.4",
    "puppeteer-core": "^25.16.0"
  },
  "dependencies": {
    "d3-array": "^3.2.4",
    "d3-axis": "^3.0.0",
    "d3-scale": "^4.0.2",
    "d3-selection": "^3.0.0",
    "d3-shape": "^3.2.0",
    "lit": "^3.3.3"
  }
}
